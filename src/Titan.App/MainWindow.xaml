<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Titan.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Titan.App.Views"
    Title="TITAN">

    <Grid x:Name="Root" Background="{StaticResource Bg}" PointerMoved="Root_PointerMoved" PointerExited="Root_PointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / title bar -->
        <Grid Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="48,0,150,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="DragArea" Grid.Column="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="TITAN" FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="16" CharacterSpacing="420" VerticalAlignment="Center" />
                    <TextBlock Text="ARCHIVO 01 · CONTENCIÓN" Style="{StaticResource Label}" FontSize="10" CharacterSpacing="120" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="Tabs" Grid.Column="1" Orientation="Horizontal" Spacing="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="28,0,0,0">
                <Rectangle x:Name="ModeDot" Width="6" Height="6" Fill="{StaticResource Ink}" VerticalAlignment="Center" />
                <TextBlock x:Name="Status" Style="{StaticResource Label}" FontSize="10" CharacterSpacing="100" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid x:Name="Stage" Grid.Row="1">
            <views:HomeView x:Name="Home" />
            <views:MemoryView x:Name="Memory" Visibility="Collapsed" />
            <views:PlaceholderView x:Name="Games" Visibility="Collapsed" Kicker="BIBLIOTECA" Title="JUEGOS REGISTRADOS"
                                   Body="Fase 3. Detección de Steam, Epic, GOG y Xbox; auto-boost al abrir un juego." />
            <views:PlaceholderView x:Name="Reports" Visibility="Collapsed" Kicker="INFORME · PRESENTMON" Title="EVIDENCIA"
                                   Body="Fase 4. FPS, 1% lows y tirones de cada sesión, con y sin BOOST." />
        </Grid>

        <!-- Cinema: vignette + scan sweep -->
        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.45" RadiusX="0.75" RadiusY="0.75" GradientOrigin="0.5,0.45">
                    <GradientStop Color="#00000000" Offset="0.72" />
                    <GradientStop Color="#12181408" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="Scan" Grid.RowSpan="2" Height="140" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0">
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="ScanShift" Y="-140" />
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00F2C200" Offset="0" />
                    <GradientStop Color="#12F2C200" Offset="0.8" />
                    <GradientStop Color="#8CF2C200" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Xbox mode bar -->
        <Grid x:Name="PadBar" Grid.Row="1" Height="38" VerticalAlignment="Bottom" Background="{StaticResource Ink}" Padding="48,0" Visibility="Collapsed">
            <StackPanel x:Name="PadLegend" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="LT" Style="{StaticResource Label}" Foreground="#EDEDE9" FontSize="10" />
                    <Grid Width="46" Height="3" Background="#2EFFFFFF" VerticalAlignment="Center">
                        <Rectangle x:Name="LtMeter" Width="0" HorizontalAlignment="Left" Fill="{StaticResource Gold}" />
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="RT" Style="{StaticResource Label}" Foreground="#EDEDE9" FontSize="10" />
                    <Grid Width="46" Height="3" Background="#2EFFFFFF" VerticalAlignment="Center">
                        <Rectangle x:Name="RtMeter" Width="0" HorizontalAlignment="Left" Fill="{StaticResource Gold}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Cold open -->
        <Button x:Name="Intro" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="Intro_Click"
                Background="#0A0A0B" BorderThickness="0" Padding="0" AutomationProperties.Name="Saltar introducción">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Width="520" Spacing="20">
                <TextBlock Text="TITAN" FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="13" CharacterSpacing="500" Foreground="{StaticResource Gold}" />
                <TextBlock x:Name="IntroText" FontFamily="{StaticResource Mono}" FontSize="13" LineHeight="25" Foreground="#EDEDE9" MinHeight="170" TextWrapping="Wrap" />
                <TextBlock Text="CLIC O BOTÓN A PARA SALTAR" FontFamily="{StaticResource Mono}" FontSize="10" CharacterSpacing="200" Foreground="#6E7076" />
            </StackPanel>
        </Button>
    </Grid>
</Window>
