<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Titan.App.Views.MemoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="48,34,48,44" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
            <TextBlock x:Name="Kicker" Style="{StaticResource Label}" />
            <TextBlock Text="CONTENIDO DE MEMORIA" Style="{StaticResource Headline}" FontSize="44" />
            <TextBlock Text="Lectura directa de las listas de memoria. Equivalente a RAMMap." Style="{StaticResource Label}" FontSize="12" CharacterSpacing="0" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- DNA helix meter + legend -->
            <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <SwapChainPanel x:Name="HelixPanel" Width="230" Height="500" VerticalAlignment="Top"
                                    AutomationProperties.Name="Doble hélice de memoria: cada peldaño es un gigabyte" />
                    <Grid Grid.Column="1" Padding="0,8,0,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8"><Rectangle Width="9" Height="9" Fill="{StaticResource Gold}" Stroke="#40000000" /><TextBlock Text="LIBRE REAL" Style="{StaticResource Label}" /></StackPanel>
                            <TextBlock x:Name="FreeValue" Style="{StaticResource Figure}" FontSize="26" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8"><Rectangle Width="9" Height="9" Fill="{StaticResource StandbyWhite}" Stroke="#40000000" /><TextBlock Text="STANDBY" Style="{StaticResource Label}" /></StackPanel>
                            <TextBlock x:Name="StandbyValue" Style="{StaticResource Figure}" FontSize="26" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8"><Rectangle Width="9" Height="9" Fill="{StaticResource Modified}" Stroke="#40000000" /><TextBlock Text="MODIFICADA" Style="{StaticResource Label}" /></StackPanel>
                            <TextBlock x:Name="ModifiedValue" Style="{StaticResource Figure}" FontSize="26" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8"><Rectangle Width="9" Height="9" Fill="{StaticResource Ink}" /><TextBlock Text="EN USO" Style="{StaticResource Label}" /></StackPanel>
                            <TextBlock x:Name="InUseValue" Style="{StaticResource Figure}" FontSize="26" />
                        </StackPanel>
                        <TextBlock x:Name="RungNote" Grid.Row="4" Style="{StaticResource Label}" FontSize="10" CharacterSpacing="60" TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Manual purge, RAMMap style -->
            <Border Grid.Column="1" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0">
                <StackPanel x:Name="Ops" />
            </Border>

            <!-- Guardian -->
            <Border Grid.Column="2" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="GUARDIÁN" Style="{StaticResource Headline}" FontSize="18" VerticalAlignment="Center" />
                        <CheckBox x:Name="GuardToggle" Content="ACTIVO" FontFamily="{StaticResource Mono}" FontSize="10" CharacterSpacing="160"
                                  Checked="Guard_Changed" Unchecked="Guard_Changed" MinWidth="0"
                                  FocusVisualPrimaryBrush="{StaticResource Gold}" FocusVisualPrimaryThickness="2" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" FontSize="12" CharacterSpacing="0" TextWrapping="Wrap" LineHeight="20"
                               Text="Purga la caché solo cuando de verdad falta memoria. Nada de purgas a ciegas." />
                    <StackPanel Grid.Row="2" Spacing="12">
                        <Grid><TextBlock Text="Umbral de memoria libre" Style="{StaticResource Label}" FontSize="11" CharacterSpacing="0" /><TextBlock Text="1 GB" Style="{StaticResource Label}" Foreground="{StaticResource Ink}" HorizontalAlignment="Right" /></Grid>
                        <Grid><TextBlock Text="Caché mínima para purgar" Style="{StaticResource Label}" FontSize="11" CharacterSpacing="0" /><TextBlock Text="1 GB" Style="{StaticResource Label}" Foreground="{StaticResource Ink}" HorizontalAlignment="Right" /></Grid>
                        <Grid><TextBlock Text="Intervalo mínimo" Style="{StaticResource Label}" FontSize="11" CharacterSpacing="0" /><TextBlock Text="30 s" Style="{StaticResource Label}" Foreground="{StaticResource Ink}" HorizontalAlignment="Right" /></Grid>
                    </StackPanel>
                    <TextBlock x:Name="Voice" Grid.Row="4" Style="{StaticResource Body}" FontSize="11" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
