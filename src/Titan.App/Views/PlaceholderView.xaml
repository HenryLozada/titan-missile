<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Titan.App.Views.PlaceholderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="48,40" Spacing="10">
        <TextBlock x:Name="KickerText" Style="{StaticResource Label}" />
        <TextBlock x:Name="TitleText" Style="{StaticResource Headline}" FontSize="44" />
        <TextBlock x:Name="BodyText" Style="{StaticResource Label}" FontSize="12" CharacterSpacing="0" MaxWidth="560" HorizontalAlignment="Left" TextWrapping="Wrap" />
        <Border Margin="0,24,0,0" Height="360" BorderBrush="#C4C5C1" BorderThickness="1">
            <TextBlock Text="EN CONSTRUCCIÓN" Style="{StaticResource Label}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </StackPanel>
</UserControl>
