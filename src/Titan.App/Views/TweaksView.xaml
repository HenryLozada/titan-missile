<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Titan.App.Views.TweaksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="48,34,48,44" RowSpacing="22" ColumnSpacing="44">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="10">
            <TextBlock Text="ESTADO 05 · PERSISTENCIA" Style="{StaticResource Label}" />
            <TextBlock Text="AJUSTES FINOS" Style="{StaticResource Headline}" FontSize="34" />
            <TextBlock Text="Sobreviven a reinicios. Cada valor original queda archivado para deshacerlo cuando quieras." Style="{StaticResource Label}" FontSize="12" CharacterSpacing="0" />
        </StackPanel>

        <!-- The cube: rigid, amber-edged -->
        <StackPanel Grid.Row="1" Spacing="14">
            <SwapChainPanel x:Name="CubePanel" Width="300" Height="300" />
            <TextBlock x:Name="Count" Style="{StaticResource Label}" Foreground="{StaticResource Ink}" />
            <Button x:Name="RestorePointButton" Style="{StaticResource Pill}" Content="CREAR PUNTO DE RESTAURACIÓN" HorizontalAlignment="Stretch" Click="RestorePoint_Click" />

            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,4,0,0">
                <StackPanel Spacing="12">
                    <TextBlock Text="EN EL JUEGO" Style="{StaticResource Label}" />
                    <CheckBox x:Name="OverlayToggle" Content="CONTADOR DE FPS SOBRE EL JUEGO" FontFamily="{StaticResource Mono}" FontSize="10"
                              CharacterSpacing="120" MinWidth="0" Checked="Overlay_Changed" Unchecked="Overlay_Changed"
                              FocusVisualPrimaryBrush="{StaticResource Gold}" FocusVisualPrimaryThickness="2" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="ESQUINA" Style="{StaticResource Label}" FontSize="10" VerticalAlignment="Center" />
                        <ComboBox x:Name="CornerBox" MinWidth="150" FontFamily="{StaticResource Mono}" FontSize="11" SelectionChanged="Corner_Changed">
                            <ComboBoxItem Content="Arriba izquierda" />
                            <ComboBoxItem Content="Arriba derecha" />
                            <ComboBoxItem Content="Abajo izquierda" />
                            <ComboBoxItem Content="Abajo derecha" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Label}" FontSize="10" CharacterSpacing="0" TextWrapping="Wrap" LineHeight="15"
                               Text="Se ve en juegos en ventana o pantalla completa sin bordes. En pantalla completa exclusiva, ningún overlay externo aparece." />
                </StackPanel>
            </Border>

            <TextBlock x:Name="Voice" Style="{StaticResource Body}" FontSize="11" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Rows" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
