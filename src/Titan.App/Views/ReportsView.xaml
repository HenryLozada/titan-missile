<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Titan.App.Views.ReportsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="48,34,48,44" RowSpacing="22" ColumnSpacing="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2">
            <StackPanel Spacing="10">
                <TextBlock Text="INFORME · ETW / PRESENT" Style="{StaticResource Label}" />
                <TextBlock Text="EVIDENCIA" Style="{StaticResource Headline}" FontSize="34" />
                <TextBlock x:Name="Sub" Style="{StaticResource Label}" FontSize="12" CharacterSpacing="0"
                           Text="Cada sesión con BOOST se mide sola. Para comparar, marca una sesión 'sin BOOST' desde Juegos (···)." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="CopyButton" Style="{StaticResource Pill}" Content="COPIAR RESUMEN" Click="Copy_Click" />
                <Button x:Name="SaveButton" Style="{StaticResource Pill}" Content="GUARDAR TARJETA" Click="Save_Click"
                        Background="{StaticResource Ink}" Foreground="{StaticResource Bg}" />
            </StackPanel>
        </Grid>

        <!-- Sessions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Sessions" />
            </ScrollViewer>
        </Border>

        <!-- Comparison card (this panel is what GUARDAR TARJETA renders) -->
        <Grid x:Name="Card" Grid.Row="1" Grid.Column="1" Background="{StaticResource Bg}" RowSpacing="18" Padding="0,14,0,0"
              BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="GameTitle" Style="{StaticResource Headline}" FontSize="22" />
                <TextBlock x:Name="Live" Style="{StaticResource Label}" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="FPS PROMEDIO" Style="{StaticResource Label}" />
                    <TextBlock x:Name="AvgOn" Style="{StaticResource Figure}" FontSize="44" />
                    <TextBlock x:Name="AvgOff" Style="{StaticResource Label}" FontSize="11" CharacterSpacing="0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="1% LOWS" Style="{StaticResource Label}" />
                    <TextBlock x:Name="LowOn" Style="{StaticResource Figure}" FontSize="44" />
                    <TextBlock x:Name="LowOff" Style="{StaticResource Label}" FontSize="11" CharacterSpacing="0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                    <TextBlock Text="TIRONES &gt; 50 MS" Style="{StaticResource Label}" />
                    <TextBlock x:Name="StutOn" Style="{StaticResource Figure}" FontSize="44" />
                    <TextBlock x:Name="StutOff" Style="{StaticResource Label}" FontSize="11" CharacterSpacing="0" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="TIEMPO POR CUADRO (MS)" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="6"><Rectangle Width="14" Height="2" Fill="{StaticResource Ink}" VerticalAlignment="Center" /><TextBlock Text="BOOST" Style="{StaticResource Label}" FontSize="10" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6"><Rectangle Width="14" Height="2" Fill="#AFB0AC" VerticalAlignment="Center" /><TextBlock Text="SIN BOOST" Style="{StaticResource Label}" FontSize="10" /></StackPanel>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Canvas x:Name="Chart" SizeChanged="Chart_SizeChanged" Background="Transparent">
                        <Polyline x:Name="LineOff" Stroke="#AFB0AC" StrokeThickness="1.2" />
                        <Polyline x:Name="LineOn" Stroke="{StaticResource Ink}" StrokeThickness="1.4" />
                        <TextBlock x:Name="ChartEmpty" Style="{StaticResource Label}" Canvas.Left="16" Canvas.Top="16" />
                    </Canvas>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
